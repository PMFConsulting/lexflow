# Copia este ficheiro para .env e preenche. O .env nunca é commitado.

# ---------------------------------------------------------------------------
# Base de dados — Supabase (plano gratuito)
# ---------------------------------------------------------------------------
# Project Settings › Database › Connection string › URI (modo "Transaction",
# porta 6543). O modo transaction usa pgBouncer, e é por isso que a ligação
# desliga prepared statements em src/db/index.ts.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# Autenticação — Better Auth
# ---------------------------------------------------------------------------
# Gera com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email — Resend (plano gratuito: 3.000/mês, 100/dia)
# ---------------------------------------------------------------------------
# Sem chave, os emails são escritos na consola em vez de enviados.
RESEND_API_KEY=""
# Remetente dos três emails ao cliente (registo, confirmação de receção e
# boas-vindas). O domínio tem de estar verificado no Resend — sem isso a API
# recusa o envio, e a falha só aparece no log.
EMAIL_REMETENTE="POC@jmassano.pt"
# Destino das notificações internas de novo processo submetido. Sem valor,
# usa-se um endereço por omissão em src/features/onboarding/acoes.ts.
EMAIL_NOTIFICACOES=""

# ---------------------------------------------------------------------------
# Armazenamento — servidor da sociedade, por SFTP
# ---------------------------------------------------------------------------
# As credenciais não se põem aqui em claro: entram por
# `pnpm armazenamento configurar`, que as cifra com esta chave antes de as
# gravar. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARMAZENAMENTO_CHAVE=""
# Lidas só no momento do `pnpm armazenamento configurar` — depois disso vivem
# cifradas na base de dados e podem sair daqui.
SERVIDOR_HOST=""
SERVIDOR_PORTA=""
SERVIDOR_UTILIZADOR=""
SERVIDOR_SEGREDO=""
SERVIDOR_CHAVE_PRIVADA=""
# SHA-256 da chave pública do host, como o `curl --hostpubsha256` a quer. Sem
# isto, o primeiro SFTP contra um host desconhecido aceita quem responder.
SERVIDOR_IMPRESSAO_HOST=""
SERVIDOR_CAMINHO_BASE=""
