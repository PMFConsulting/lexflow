# Copia este ficheiro para .env e preenche. O .env nunca é commitado.

# ---------------------------------------------------------------------------
# Base de dados — Supabase (plano gratuito)
# ---------------------------------------------------------------------------
# Project Settings › Database › Connection string › URI (modo "Transaction",
# porta 6543). O modo transaction usa pgBouncer, e é por isso que a ligação
# desliga prepared statements em src/db/index.ts.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# Autenticação — Better Auth
# ---------------------------------------------------------------------------
# Gera com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email — Brevo (300/dia) com o Resend em recurso (3.000/mês, 100/dia)
# ---------------------------------------------------------------------------
# Sem chave nenhuma, os emails são escritos na consola em vez de enviados.
# Com as duas, tenta-se o Brevo primeiro e, se ele recusar, o Resend — um envio
# só falha quando falharem os dois, e o motivo no /emails leva as duas razões.
BREVO_API_KEY=""
RESEND_API_KEY=""
# Remetente dos três emails ao cliente (registo, confirmação de receção e
# boas-vindas). O domínio tem de estar verificado no Resend — sem isso a API
# recusa o envio, e a falha só aparece no log.
EMAIL_REMETENTE="POC@jmassano.pt"
# Destino do aviso interno de novo processo submetido. Sem valor, o aviso
# simplesmente não sai — e fica um `console.warn` a dizê-lo. Não há endereço por
# omissão de propósito: o que aqui estava era um endereço pessoal escrito no
# código, e numa instalação a que faltasse esta variável eram os dados de
# processos de clientes a sair para a caixa de correio errada. Os dois emails ao
# cliente e o arquivo em SFTP não dependem disto.
EMAIL_NOTIFICACOES=""

# ---------------------------------------------------------------------------
# Armazenamento — servidor da sociedade, por SFTP
# ---------------------------------------------------------------------------
# As credenciais não se põem aqui em claro: entram por
# `pnpm armazenamento configurar`, que as cifra com esta chave antes de as
# gravar. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARMAZENAMENTO_CHAVE=""
# Lidas só no momento do `pnpm armazenamento configurar` — depois disso vivem
# cifradas na base de dados e podem sair daqui.
SERVIDOR_HOST=""
SERVIDOR_PORTA=""
SERVIDOR_UTILIZADOR=""
SERVIDOR_SEGREDO=""
SERVIDOR_CHAVE_PRIVADA=""
# SHA-256 da chave pública do host, como o `curl --hostpubsha256` a quer. Sem
# isto, o primeiro SFTP contra um host desconhecido aceita quem responder.
SERVIDOR_IMPRESSAO_HOST=""
SERVIDOR_CAMINHO_BASE=""

# ---------------------------------------------------------------------------
# API dos onboardings — para o bot
# ---------------------------------------------------------------------------
# A chave que autentica quem chama `/api/onboarding/*`. **Sem ela a API responde
# 503 e não fica aberta** — não há valor por omissão, de propósito: uma chave
# num ficheiro de exemplo é uma chave pública, e a alternativa era a instalação
# que esquecesse a variável a servir dados de KYC a quem os pedisse.
#
# Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_CHAVE=""
