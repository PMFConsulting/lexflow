# Copia este ficheiro para .env e preenche. O .env nunca é commitado.

# ---------------------------------------------------------------------------
# Base de dados — Postgres
# ---------------------------------------------------------------------------
# O Postgres corre no próprio servidor, gerido pelo Coolify (D17): dentro da
# rede do Coolify o anfitrião é o nome do serviço, não `localhost`.
#
#   produção (contentor):   postgresql://utilizador:senha@postgres:5432/lexflow
#   desenvolvimento local:  postgresql://postgres:postgres@localhost:5432/lexflow
#
# Se algum dia a ligação passar por um pooler em modo transaction (pgBouncer),
# não é preciso mexer aqui: os prepared statements já vêm desligados em
# src/db/index.ts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lexflow"

# ---------------------------------------------------------------------------
# Autenticação — Better Auth
# ---------------------------------------------------------------------------
# Gera com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email — cinco canais, tentados por esta ordem
# ---------------------------------------------------------------------------
# Sem chave nenhuma, os emails são escritos na consola em vez de enviados.
# Com mais do que uma, tenta-se pela ordem abaixo e um envio só falha quando
# falharem todas — o motivo no /emails leva as razões de cada uma.
#
#   1. Resend   — 3.000/mês, 100/dia
#   2. Mailjet  — 200/dia; só entra com a CHAVE **e** o SEGREDO, os dois
#   3. Brevo    — 300/dia
#   4. Twilio SendGrid — opcional; produção futura via Twilio
#   5. SMTP próprio — sem quota, mas sem DKIM do domínio e sem id de mensagem
#      (a entrega dessas linhas não se confirma; ver `pnpm email:conferir`)
RESEND_API_KEY=""
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
BREVO_API_KEY=""
# Twilio SendGrid (opcional; produção futura via Twilio).
TWILIO_SENDGRID_API_KEY=""
# O postfix do servidor da sociedade. Só o anfitrião e a porta: este canal não
# autentica — é um relay local, e é por isso que fica em último e nunca aberto
# à Internet. A porta é 25 por omissão.
SMTP_HOST=""
SMTP_PORT=""
# Remetente dos emails ao cliente (registo, confirmação de receção e
# boas-vindas). **O domínio tem de estar verificado no fornecedor** — sem isso a
# API responde 403 e a falha só aparece no /emails.
# Preencher sempre com um endereço do domínio verificado desta instalação. O
# valor por omissão (`lexflow@lex-flow.pt`, em src/email-remetente-default.mjs)
# é neutro e da plataforma de propósito: o que aqui estava era o domínio de um
# cliente do primeiro piloto, e uma instalação sem esta variável escrevia aos
# clientes a partir de um domínio antigo que ninguém verificou.
EMAIL_REMETENTE="lexflow@lex-flow.pt"
# Destino do aviso interno de novo processo submetido. Sem valor, o aviso
# simplesmente não sai — e fica um `console.warn` a dizê-lo. Não há endereço por
# omissão de propósito: o que aqui estava era um endereço pessoal escrito no
# código, e numa instalação a que faltasse esta variável eram os dados de
# processos de clientes a sair para a caixa de correio errada. Os dois emails ao
# cliente e o arquivo em SFTP não dependem disto.
EMAIL_NOTIFICACOES=""

# ---------------------------------------------------------------------------
# Armazenamento — servidor da sociedade, por SFTP
# ---------------------------------------------------------------------------
# As credenciais não se põem aqui em claro: entram por
# `pnpm armazenamento configurar`, que as cifra com esta chave antes de as
# gravar. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARMAZENAMENTO_CHAVE=""
# Lidas só no momento do `pnpm armazenamento configurar` — depois disso vivem
# cifradas na base de dados e podem sair daqui.
SERVIDOR_HOST=""
SERVIDOR_PORTA=""
SERVIDOR_UTILIZADOR=""
SERVIDOR_SEGREDO=""
SERVIDOR_CHAVE_PRIVADA=""
# SHA-256 da chave pública do host, como o `curl --hostpubsha256` a quer. Sem
# isto, o primeiro SFTP contra um host desconhecido aceita quem responder.
SERVIDOR_IMPRESSAO_HOST=""
SERVIDOR_CAMINHO_BASE=""

# Armazenamento — bucket S3 dedicado por sociedade (alternativa ao SFTP acima)
# ---------------------------------------------------------------------------
# Estas três lidas em dois momentos: automaticamente, dentro de `criarSociedade`,
# sempre que o super_admin cria uma sociedade nova (o bucket nasce com ela — não
# é um passo manual); e por `pnpm armazenamento configurar --protocolo s3
# --bucket <nome>` para reconfigurar uma sociedade já existente. Em ambos os
# casos, as credenciais vivem cifradas na base de dados depois disso, tal como
# as do SFTP — nunca em claro. O nome do bucket não é segredo e fica gravado em
# claro na coluna `bucket_s3`: é essa coluna, e não estas variáveis, que decide
# se uma sociedade usa S3 ou SFTP. Um bucket por sociedade, nunca partilhado.
#
# A policy do utilizador IAM (`lexflow-app`) tem de incluir `s3:CreateBucket`,
# com condição de prefixo `lexflow-*` — sem essa permissão a criação automática
# falha com 403, mas isso **não** impede a sociedade de ser criada: fica só sem
# bucket, com um aviso no ecrã, e é criado mais tarde à mão com
# `pnpm armazenamento configurar`. A atualização da policy é feita na consola
# da AWS por quem administra a conta, fora deste código.
AWS_REGION=""
LEXFLOW_S3_ACCESS_KEY_ID=""
LEXFLOW_S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# API dos onboardings — para o bot
# ---------------------------------------------------------------------------
# A chave que autentica quem chama `/api/onboarding/*`. **Sem ela a API responde
# 503 e não fica aberta** — não há valor por omissão, de propósito: uma chave
# num ficheiro de exemplo é uma chave pública, e a alternativa era a instalação
# que esquecesse a variável a servir dados de KYC a quem os pedisse.
#
# Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_CHAVE=""
